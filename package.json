{
  "name": "dsh-tui-app",
  "version": "0.1.8",
  "description": "Readline-based interactive terminal profile bundle for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./startup": "./lib/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/assets/tui-startup.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/check-screen.mjs && node test/check-presets.mjs && node scripts/check-package.mjs",
    "check": "node --check lib/index.js && node --check lib/startup.js && node --check test/vt.mjs && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "terminal",
    "tui",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhfgyyf/dsh-tui-app.git"
  },
  "homepage": "https://github.com/yhfgyyf/dsh-tui-app#readme",
  "bugs": {
    "url": "https://github.com/yhfgyyf/dsh-tui-app/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-agent-presets": { "optional": true },
    "@deepseek-ai/dsh-cmdline": { "optional": true },
    "@deepseek-ai/dsh-code-runtime-worker-thread": { "optional": true },
    "@deepseek-ai/dsh-cordis-host-runner": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "commander": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
